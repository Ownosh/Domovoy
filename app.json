{
  "expo": {
    "name": "Домовой",
    "slug": "domovoy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "domovoy",
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D6A4F",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Приложению нужен доступ к геолокации, чтобы построить маршрут до выбранного места от вашего текущего положения.",
          "locationWhenInUsePermission": "Приложению нужен доступ к геолокации, чтобы построить маршрут до выбранного места от вашего текущего положения."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "./plugins/withYandexMapKit.js",
        {
          "apiKey": "380e6e80-b316-4896-9572-fd01f0e87a80"
        }
      ]
    ],
    "android": {
      "package": "com.domovoy.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.domovoy.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "61825a3c-45b6-47d3-aa1d-c717458892f2"
      }
    },
    "owner": "oownosh"
  }
}
