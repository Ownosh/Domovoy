# Timeweb Cloud S3 — пример для backend/.env или Domovoy_admin/backend/.env
# Backend подхватывает оба файла при старте.

S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=ваш-бакет
S3_ACCESS_KEY=ваш_access_key
S3_SECRET_KEY=ваш_secret_key

# Публичный URL для приложения (один из вариантов):
# 1) virtual-hosted (рекомендуется для публичного бакета Timeweb):
#    https://ваш-бакет.s3.twcstorage.ru/uploads/файл.jpg
# S3_PUBLIC_STYLE=virtual

# 2) или явно задайте базовый URL:
# S3_PUBLIC_URL=https://ваш-бакет.s3.twcstorage.ru

# Бакет должен быть типа «public» в панели Timeweb, иначе фото в приложении не откроются (403).

# Локальное хранение вместо S3 (только для разработки):
# FILES_STORAGE=local

# ImageKit — только когда CDN реально подключён к бакету:
# IMAGEKIT_ENABLED=1
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/ваш_id

PUBLIC_API_URL=http://5.181.109.109:3001