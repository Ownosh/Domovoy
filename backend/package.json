    "@types/multer": "^2.1.0",
    "bcrypt": "*",
    "cors": "*",
    "dotenv": "*",
    "express": "*",
    "express-rate-limit": "*",
    "helmet": "*",
    "jsonwebtoken": "*",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "openai": "^6.42.0",
    "zod": "*"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "@types/bcrypt": "*",
    "@types/cors": "*",
